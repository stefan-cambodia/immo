# Repli cron pour les hôtes sans systemd (conteneur, BSD, hébergement mutualisé).
# Préférer ops/systemd/ partout ailleurs : Persistent=true y rattrape les
# exécutions manquées, cron non.
#
# À copier dans /etc/cron.d/cambodia-immo (root:root, 0644) après avoir
# remplacé __APP_ROOT__ et __APP_USER__ — ops/install-scheduler.sh --cron le fait.
#
# CRON_TZ est posé : sans lui, « 01:30 » dépend du fuseau de l'hôte.
CRON_TZ=Asia/Phnom_Penh
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
MAILTO=ops@example.test

# min  heure  jour  mois  jsem  utilisateur  commande
*/15   *      *     *     *     __APP_USER__  __APP_ROOT__/ops/send-alerts.sh
5-59/15 *     *     *     *     __APP_USER__  __APP_ROOT__/ops/process-media.sh
0      *      *     *     *     __APP_USER__  __APP_ROOT__/ops/expire-listings.sh
30     1      *     *     *     __APP_USER__  __APP_ROOT__/ops/billing.sh
0      3      *     *     0     __APP_USER__  __APP_ROOT__/ops/audit-retention.sh
