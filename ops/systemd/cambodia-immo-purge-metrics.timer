[Unit]
Description=Khmer Estate — purge des mesures de terrain (hebdomadaire, dimanche 03:30)

[Timer]
Unit=cambodia-immo@purge-metrics.service
# Après la rétention du journal d'audit de 03:00 : les deux purges du
# dimanche se suivent sans se chevaucher.
OnCalendar=Sun *-*-* 03:30:00
# Rattrape une exécution manquée pendant un arrêt de la machine — ce que
# cron ne sait pas faire, et la raison de préférer les unités systemd.
Persistent=true
RandomizedDelaySec=10min
AccuracySec=1min


[Install]
WantedBy=timers.target
