[Unit]
Description=Khmer Estate — envoi des alertes (toutes les 15 minutes)

[Timer]
Unit=cambodia-immo@send-alerts.service
OnCalendar=*:00/15
# Rattrape une exécution manquée pendant un arrêt de la machine — ce que
# cron ne sait pas faire, et la raison de préférer les unités systemd.
Persistent=true
RandomizedDelaySec=30s
AccuracySec=1min


[Install]
WantedBy=timers.target
