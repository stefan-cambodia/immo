# Base de données
DATABASE_URL=postgres://immo:immo@localhost:5433/cambodia_immo

# Cartographie — couche d'abstraction (§5.4, §11) : basculer de fournisseur
# revient à changer ces deux variables, aucun code applicatif ne dépend du
# fournisseur. Valeurs possibles pour MAP_PROVIDER : maptiler | protomaps | osm | google
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_MAP_API_KEY=

# URL publique (hreflang, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Journal d'audit
AUDIT_RETENTION_DAYS=730
AUDIT_ARCHIVE_DIR=var/audit-archive

# Bot Telegram (§6.1). Jeton obtenu auprès de @BotFather.
TELEGRAM_BOT_TOKEN=

# Extraction LLM. Le SDK lit aussi un profil `ant auth login` si la variable
# n'est pas définie.
ANTHROPIC_API_KEY=

# Alertes sur critères sauvegardés (phase 3). Transport email : file (défaut,
# écrit dans MAIL_OUTBOX au lieu d'envoyer) | resend | postmark.
MAIL_PROVIDER=file
MAIL_API_KEY=
MAIL_FROM="Khmer Estate <alerts@khmerestate.kh>"
MAIL_OUTBOX=var/mail-outbox.jsonl
# Nom du bot (sans @) pour les liens profonds t.me/<bot>?start=… ; vide = le
# canal Telegram n'est pas proposé aux visiteurs.
TELEGRAM_BOT_USERNAME=

# Médias (§7) — couche de stockage des sources envoyées et des variantes
# AVIF/WebP/JPEG. local (défaut) : fichiers sous MEDIA_LOCAL_DIR, servis par
# l'application sur /media/… ; s3 : PUT signés SigV4 (AWS, MinIO, R2), le
# même chemin public étant alors servi par le CDN (MEDIA_PUBLIC_URL, obligatoire).
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=var/media
MEDIA_PUBLIC_URL=/media
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Archives du journal d'audit. ARCHIVE_KEY (64 hexadécimaux, AES-256-GCM) :
# le clair ne survit pas sur le disque ; vide = archives en clair.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ARCHIVE_S3_BUCKET pose une copie hors site sur un bucket DÉDIÉ, via les
# accès S3_* ci-dessus, chacun surchargeable par ARCHIVE_S3_ENDPOINT,
# ARCHIVE_S3_REGION, ARCHIVE_S3_ACCESS_KEY_ID, ARCHIVE_S3_SECRET_ACCESS_KEY.
ARCHIVE_KEY=
ARCHIVE_S3_BUCKET=

# Sauvegarde de la base (ops/backup-db.sh). En développement, pg_dump vit
# dans le conteneur ; en production, laisser BACKUP_PG_DUMP/BACKUP_PG_RESTORE
# vides (binaires de l'hôte) et BACKUP_DATABASE_URL vide (= DATABASE_URL).
BACKUP_DIR=var/backups
BACKUP_KEEP=14
BACKUP_PG_DUMP=docker exec -i cambodia-immo-db pg_dump
BACKUP_PG_RESTORE=docker exec -i cambodia-immo-db pg_restore
BACKUP_DATABASE_URL=postgres://immo:immo@localhost:5432/cambodia_immo

# En production, ce fichier se pose hors du dépôt : /etc/cambodia-immo/env
# (root:immo, 0640), lu par les unités systemd de ops/systemd/ — et par le
# serveur Next si son unité le référence de la même façon.
