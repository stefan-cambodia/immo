# Base de données
DATABASE_URL=postgres://immo:immo@localhost:5433/cambodia_immo

# Cartographie — couche d'abstraction (§5.4, §11) : basculer de fournisseur
# revient à changer ces deux variables, aucun code applicatif ne dépend du
# fournisseur. Valeurs possibles pour MAP_PROVIDER : maptiler | protomaps | osm | google
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_MAP_API_KEY=

# URL publique (hreflang, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Journal d'audit
AUDIT_RETENTION_DAYS=730
AUDIT_ARCHIVE_DIR=var/audit-archive

# Bot Telegram (§6.1). Jeton obtenu auprès de @BotFather.
TELEGRAM_BOT_TOKEN=

# Extraction LLM. Le SDK lit aussi un profil `ant auth login` si la variable
# n'est pas définie.
ANTHROPIC_API_KEY=
