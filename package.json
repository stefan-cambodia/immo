{
  "name": "cambodia-immo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:up": "docker compose up -d db && node db/wait-for-db.mjs",
    "db:down": "docker compose down",
    "db:migrate": "node db/migrate.mjs",
    "db:seed": "node db/seed/seed.mjs",
    "db:reset": "node db/migrate.mjs --reset && node db/seed/seed.mjs",
    "setup": "npm run db:up && npm run db:migrate && npm run db:seed",
    "audit:retention": "node db/jobs/audit-retention.mjs",
    "audit:verify": "node db/jobs/audit-verify.mjs",
    "listings:expire": "ops/expire-listings.sh",
    "listings:expire-check": "ops/expire-listings.sh --dry-run",
    "audit:retention-check": "ops/audit-retention.sh --dry-run",
    "bot": "node db/jobs/telegram-bot.mjs",
    "bot:once": "node db/jobs/telegram-bot.mjs --once",
    "bot:reminders": "node db/jobs/send-reminders.mjs",
    "check:bot": "node db/checks/bot-conversation.mjs",
    "check:extraction": "node db/checks/extraction-contract.mjs",
    "translate": "node db/jobs/translate-listings.mjs",
    "translate:check": "node db/jobs/translate-listings.mjs --dry-run",
    "check:translation": "node db/checks/translation.mjs",
    "check:seo": "node db/checks/seo-landing.mjs",
    "check:views": "node db/checks/view-tracking.mjs",
    "alerts:send": "ops/send-alerts.sh",
    "alerts:send-check": "ops/send-alerts.sh --dry-run",
    "check:alerts": "node db/checks/alerts.mjs",
    "billing:run": "ops/billing.sh",
    "billing:run-check": "ops/billing.sh --dry-run",
    "check:billing": "node db/checks/billing.mjs",
    "check:projects": "node db/checks/projects.mjs",
    "check:estimate": "node db/checks/estimate.mjs",
    "check:compare": "node db/checks/compare.mjs",
    "check:titles": "node db/checks/title-verification.mjs",
    "check:partner-api": "node db/checks/partner-api.mjs",
    "check:accounts": "node db/checks/accounts.mjs",
    "check:totp": "node db/checks/totp.mjs",
    "media:process": "ops/process-media.sh",
    "media:process-check": "ops/process-media.sh --dry-run",
    "check:media": "node db/checks/media.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "maplibre-gl": "^5.9.0",
    "next": "^15.5.4",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  }
}
